# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=

# Main reasoning model (specialist agents)
MODEL_MAIN=claude-sonnet-5-5
# Cheap per-item model (review tagging)
MODEL_FAST=claude-haiku-4-5-20251001
# Optional: LiteLLM proxy or OpenAI-compatible endpoint
# LLM_API_BASE=
# LLM_API_KEY=

# Classification via TypeSafe Jev
JEV_API_KEY=
# JEV_MODEL=jev-latest

# Optional: override the DuckDB location and the learned-effects cache
# JET_DB_PATH=data/jet.duckdb
# JET_MODELS_DIR=data/models
